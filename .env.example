# Copie este arquivo para ".env" e preencha. NUNCA publique o ".env" na internet.

# Conexão do banco PostgreSQL (a mesma do Neon que você já criou).
DATABASE_URL="cole-aqui-a-conexao-do-neon"

# Uma frase grande e aleatória (qualquer coisa longa). Protege o login.
JWT_SECRET="troque-por-uma-frase-bem-grande-e-aleatoria"

# (Opcional) Login do administrador criado na primeira vez que o site liga.
ADMIN_EMAIL="admin@giovannamatos.com"
ADMIN_PASSWORD="admin123"

# (Opcional) Pix AUTOMÁTICO pelo Mercado Pago. Deixe em branco para usar Pix manual/teste.
MERCADOPAGO_ACCESS_TOKEN=""

# Endereço público do site (só necessário com Mercado Pago, para o aviso de pagamento).
SITE_URL="http://localhost:3000"
